import os
import re
import whisper
from docx import Document
from docx.shared import Pt, Cm, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH
from google.colab import files

# ==================== 請依需要修改設定 ====================

# 轉錄語言：
# "zh" = 中文；"en" = 英文；若不想指定可改為 None
LANGUAGE = "zh"

# Whisper 模型：
# tiny / base / small / medium / large-v3 / turbo
# 越大越準確，但越慢；建議先用 small 測試
MODEL_NAME = "small"

# 每個 Word 段落最多包含多少個句子
# 例如設定為 3，代表每 3 句合成一個段落
SENTENCES_PER_PARAGRAPH = 3

# =========================================================

# 1. 顯示上傳按鈕，讓你從電腦選擇 MP3 檔案
print("請點選「選擇檔案」，上傳你的 MP3 檔案。")

uploaded = files.upload()

if not uploaded:
    raise ValueError("沒有上傳任何檔案，請重新執行這個儲存格。")

audio_filename = list(uploaded.keys())[0]
audio_path = audio_filename

if not audio_filename.lower().endswith(".mp3"):
    print("警告：你上傳的檔案不是 .mp3。Whisper 通常仍可處理常見音訊格式，但建議上傳 MP3。")

print("已成功上傳檔案：", audio_filename)
print("檔案大小：", round(os.path.getsize(audio_path) / 1024 / 1024, 2), "MB")

# 2. 載入 Whisper 模型
print(f"正在載入 Whisper 模型：{MODEL_NAME} ...")
model = whisper.load_model(MODEL_NAME)

# 3. 轉錄 MP3
print("正在轉錄語音，請稍候 ...")

transcribe_kwargs = {
    "verbose": False,
    "fp16": True
}

if LANGUAGE:
    transcribe_kwargs["language"] = LANGUAGE

result = model.transcribe(audio_path, **transcribe_kwargs)

transcript = result["text"].strip()
segments = result.get("segments", [])

print("轉錄完成！")
print("文字長度：", len(transcript), "字元")

# =========================================================
# 4. 文字清理與排版
# =========================================================

def clean_text(text):
    """清理 Whisper 常見的多餘空白與重複標點。"""
    text = text.replace("\n", " ")
    text = re.sub(r"\s+", " ", text).strip()

    # 移除標點前多餘空格
    text = re.sub(r"\s+([，。、！？；：」』）])", r"\1", text)

    # 移除重複的句號、逗號等
    text = re.sub(r"([。！？])\1+", r"\1", text)
    text = re.sub(r"([，、；：])\1+", r"\1", text)

    return text.strip()


def split_into_sentences(text):
    """
    將文字依中文標點切句。
    支援：。！？；也保留引號後的句號。
    """
    # 先統一空白
    text = clean_text(text)

    # 使用 lookahead 分句，保留句末標點
    sentences = re.split(r"(?<=[。！？；])\s*", text)

    # 移除空句子
    sentences = [s.strip() for s in sentences if s.strip()]

    return sentences


def group_sentences(sentences, sentences_per_paragraph=3):
    """將句子合併成段落，避免 Word 中每句都獨立成一段。"""
    paragraphs = []

    for i in range(0, len(sentences), sentences_per_paragraph):
        group = sentences[i:i + sentences_per_paragraph]
        paragraphs.append("".join(group))

    return paragraphs


def format_timestamp(seconds):
    """將秒數轉換為 MM:SS 格式。"""
    seconds = int(seconds)
    minutes = seconds // 60
    secs = seconds % 60
    return f"{minutes:02d}:{secs:02d}"


# 清理完整文字
transcript = clean_text(transcript)

# 將文字切句，再組成段落
sentences = split_into_sentences(transcript)
formatted_paragraphs = group_sentences(
    sentences,
    sentences_per_paragraph=SENTENCES_PER_PARAGRAPH
)

print("已切成", len(sentences), "句")
print("已排成", len(formatted_paragraphs), "個段落")

# =========================================================
# 5. 建立排版後的 Word 檔
# =========================================================

word_filename = os.path.splitext(audio_filename)[0] + "_逐字稿_排版.docx"

document = Document()

# 設定頁面邊界
for section in document.sections:
    section.top_margin = Cm(2.0)
    section.bottom_margin = Cm(2.0)
    section.left_margin = Cm(2.5)
    section.right_margin = Cm(2.5)

# 設定內文樣式
normal_style = document.styles["Normal"]
normal_style.font.name = "Calibri"
normal_style.font.size = Pt(12)

# 設定段落行距與段落間距
paragraph_format = normal_style.paragraph_format
paragraph_format.line_spacing = 1.5
paragraph_format.space_after = Pt(8)

# 文件主標題
title = document.add_heading("語音逐字稿", level=0)
title.alignment = WD_ALIGN_PARAGRAPH.CENTER

# 基本資料
info = document.add_paragraph()
info_run = info.add_run(f"來源音檔：{audio_filename}\n")
info_run.font.size = Pt(10)
info_run.font.color.rgb = RGBColor(89, 89, 89)

info_run = info.add_run(f"辨識語言：{LANGUAGE if LANGUAGE else '自動偵測'}\n")
info_run.font.size = Pt(10)
info_run.font.color.rgb = RGBColor(89, 89, 89)

info_run = info.add_run(f"使用模型：{MODEL_NAME}")
info_run.font.size = Pt(10)
info_run.font.color.rgb = RGBColor(89, 89, 89)

# 完整文字
document.add_heading("完整文字", level=1)

if formatted_paragraphs:
    for paragraph_text in formatted_paragraphs:
        p = document.add_paragraph(paragraph_text)
        p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
else:
    document.add_paragraph("沒有偵測到可轉錄的文字。")

# 分段逐字稿
if segments:
    document.add_heading("分段逐字稿", level=1)

    for seg in segments:
        start = seg.get("start", 0)
        end = seg.get("end", 0)
        text = clean_text(seg.get("text", ""))

        if not text:
            continue

        # 時間戳
        time_p = document.add_paragraph()
        time_run = time_p.add_run(
            f"[{format_timestamp(start)} - {format_timestamp(end)}]"
        )
        time_run.bold = True
        time_run.font.size = Pt(10)
        time_run.font.color.rgb = RGBColor(89, 89, 89)

        # 該段文字
        content_p = document.add_paragraph(text)
        content_p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY

        # 在每段之後加入較明顯間距
        content_p.paragraph_format.space_after = Pt(12)

# 儲存 Word 檔
document.save(word_filename)

print("排版後的 Word 檔已建立：", word_filename)

# 6. 自動下載 Word 檔到本機電腦
files.download(word_filename)
